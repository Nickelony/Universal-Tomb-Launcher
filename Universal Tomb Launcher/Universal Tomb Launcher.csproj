<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>launch</AssemblyName>
    <RootNamespace>UniversalTombLauncher</RootNamespace>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ppy.SDL3-CS" Version="2026.1002.1" />
    <PackageReference Include="ppy.SDL3_ttf-CS" Version="2026.1002.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Patches\tr4-border-fix.sdb" />
  </ItemGroup>
</Project>
